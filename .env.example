# Direct Anthropic inference
ANTHROPIC_API_KEY=

# Photo suitability checks and virtual costume try-on (server only)
OPENAI_API_KEY=
OPENAI_DECISION_MODEL=gpt-6-luna
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst

# Screenshot decomposition, query refinement and product-photo matching
OPENAI_SCREENSHOT_MODEL=gpt-6-luna

# Costume Mirror: native GPT-Live + Decisions, and live garment video
# Reuses OPENAI_API_KEY above. Never use NEXT_PUBLIC_ for provider keys.
OPENAI_LIVE_MODEL=gpt-live-1
FAL_KEY=

# Rehearsal mode: 1 disables live-session cutoffs and simultaneous photo-work limits.
# Hourly request quotas are removed in every mode; see docs/mirror-session-limits.md.
TRY_ON_TESTING_MODE=0

# Firecrawl web search and merchant-page scraping
FIRECRAWL_API_KEY=

# Free Turso database, provisioned through Vercel Marketplace
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Stripe remains in test mode for the demo
STRIPE_SECRET_KEY=
CRON_SECRET=

# Personal 3D previews use the existing FAL_KEY for every model.
# Default: hunyuan (Hunyuan 3D 3.1 Pro). Also accepts trellis (TRELLIS.2) or meshy (Meshy 7.1).
TRY_ON_3D_PROVIDER=hunyuan
# Optional stable signing secret across replicas; otherwise uses FAL_KEY.
TRY_ON_3D_SIGNING_SECRET=

# Optional TURN relay for phone cameras across different networks (server only).
# Without these, direct WebRTC works only when the devices can reach each other.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
