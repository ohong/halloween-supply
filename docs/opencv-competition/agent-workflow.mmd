%% Source for agent-workflow.svg. Render: bunx @mermaid-js/mermaid-cli -i agent-workflow.mmd -o agent-workflow.svg -b transparent
flowchart TD
  upload(["Screenshot uploaded"]) --> perceive

  perceive["PERCEIVE<br/>/v1/analyze: person, pieces,<br/>colors, garment types, embeddings"]
  perceive -- "no person or confidence &lt; 0.5" --> crop(["Ask shopper to crop to one person"])
  perceive -- "for each piece, in parallel" --> act

  act["ACT<br/>merchant search with the piece query"]
  act --> reperceive["RE-PERCEIVE<br/>/v1/match: segment each product photo,<br/>embedding similarity, CIEDE2000, HS histogram"]
  reperceive --> decide{"DECIDE<br/>decideNext(piece, results, attempt)"}

  decide -- "best verdict = match" --> accept(["Accept: piece joins the board"])
  decide -- "color_mismatch" --> rc["Retry: measured color name first"]
  decide -- "type_mismatch" --> rt["Retry: next garment type phrase"]
  decide -- "no candidates / no_garment" --> ra["Retry: alternate query"]
  decide -- "2 retries used or &lt; 6 s budget left" --> approve(["Keep best weak result:<br/>needs_approval"])

  rc --> act
  rt --> act
  ra --> act

  approve --> human{"Shopper:<br/>Use this anyway / Skip piece"}
  human -- "use" --> accept
  human -- "skip" --> skipped(["Piece skipped, nothing added"])
  accept --> cart(["Cart, then Stripe Checkout only when the shopper pays"])

  trace[["trace event at every step:<br/>{ t_ms, piece, step, detail }<br/>→ UI panel + JSON log line"]]
  perceive -.-> trace
  act -.-> trace
  reperceive -.-> trace
  decide -.-> trace
  human -.-> trace

  classDef cv fill:#e8f5e9,stroke:#2e7d32,color:#1b5e20
  classDef human fill:#e3f2fd,stroke:#1565c0,color:#0d47a1
  class perceive,reperceive cv
  class human,crop,approve human
