# COOL image: same service, but cv2 comes from the Cloud Optimized OpenCV build on the Graviton4 host.
# No opencv wheel is installed here. The host mounts COOL and points Python at it:
#   docker run -v /opt/cool:/opt/cool:ro -e OPENCV_BUILD=cool \
#     -e PYTHONPATH=/opt/cool/python_3.12/site-packages -e LD_LIBRARY_PATH=/opt/cool/cpp_sdk/lib ...
# Ubuntu 24.04 matches the AMI's glibc, and its system python3 is 3.12, which the COOL bindings target.
#   docker build --platform linux/arm64 -f vision/Dockerfile.cool -t halloween-vision:cool vision/
FROM ubuntu:24.04
RUN apt-get update && apt-get install -y --no-install-recommends python3 ca-certificates libgomp1 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.9.5 /uv /usr/local/bin/uv
WORKDIR /app
ENV PYTHONUNBUFFERED=1 UV_COMPILE_BYTECODE=1
COPY pyproject.toml uv.lock ./
RUN uv export --frozen --no-dev --no-hashes --no-emit-project | grep -v '^opencv' > /tmp/req.txt \
    && uv pip install --system --break-system-packages -r /tmp/req.txt && rm /tmp/req.txt
COPY scripts/fetch_models.py scripts/
RUN python3 scripts/fetch_models.py
COPY vocabulary.json vocabulary.npy ./
COPY app app
ARG GIT_SHA=dev
ENV GIT_SHA=$GIT_SHA OPENCV_BUILD=cool
EXPOSE 8080
CMD ["python3", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8080", "--no-access-log"]
